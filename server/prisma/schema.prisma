// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum BudgetLevel {
  LOW
  MEDIUM
  HIGH
  LUXURY
}

enum TravelStyle {
  RELAXED
  ADVENTUROUS
  CULTURAL
  LUXURY
  BUDGET
  FAMILY
  BACKPACKER
}

enum TripVisibility {
  PRIVATE
  PUBLIC
}

enum TransportMode {
  FLIGHT
  TRAIN
  BUS
  CAR
  OTHER
}

enum ExpenseCategory {
  TRANSPORT
  ACCOMMODATION
  ACTIVITY
  MEAL
  OTHER
}

enum RecommendationAction {
  VIEWED
  SAVED
  ADDED
  DISMISSED
}

enum TripGenerationStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ImageSource {
  PEXELS
  WIKIMEDIA
  UNSPLASH
  OTHER
}

enum CommunityCategory {
  TRAVEL_DISCUSSION
  DESTINATION_TIPS
  ITINERARY_HELP
  GEAR_PACKING
  TRAVEL_STORIES
}

model User {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String?
  email        String   @unique
  passwordHash String
  phoneNumber  String?
  city         String?
  country      String?
  bio          String?
  role         UserRole @default(USER)

  profileImageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preference UserPreference?

  interests UserInterest[]

  refreshTokens RefreshToken[]

  passwordResetTokens PasswordResetToken[]

  trips Trip[]

  savedDestinations SavedDestination[]

  recommendationInteractions RecommendationInteraction[]

  tripGenerations TripGeneration[]

  communityPosts   CommunityPost[]
  communityReplies CommunityReply[]
  communityLikes   CommunityPostLike[]
}

model UserPreference {
  id     Int @id @default(autoincrement())
  userId Int @unique

  language          String      @default("en")
  preferredCurrency String      @default("INR")
  budgetLevel       BudgetLevel @default(MEDIUM)
  travelStyle       TravelStyle @default(RELAXED)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Interest {
  id   Int    @id @default(autoincrement())
  name String @unique

  users UserInterest[]

  createdAt DateTime @default(now())
}

model UserInterest {
  userId     Int
  interestId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@index([interestId])
}

model RefreshToken {
  id     Int @id @default(autoincrement())
  userId Int

  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id     Int @id @default(autoincrement())
  userId Int

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Country {
  id        Int    @id @default(autoincrement())
  name      String @unique
  code      String @unique
  continent String

  cities City[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([continent])
}

model City {
  id        Int @id @default(autoincrement())
  countryId Int

  name        String
  region      String?
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  timezone    String?
  description String?

  costIndex        Int?
  averageDailyCost Decimal? @db.Decimal(10, 2)
  popularityScore  Decimal? @db.Decimal(5, 2)
  bestTimeToVisit  String?

  isActive Boolean @default(true)

  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  images CityImage[]

  activities Activity[]

  tripStops TripStop[]

  savedBy SavedDestination[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
  @@index([name])
  @@index([popularityScore])
  @@index([costIndex])
}

model Image {
  id Int @id @default(autoincrement())

  url      String
  source   ImageSource
  sourceId String?

  authorName     String?
  authorUrl      String?
  license        String?
  attributionUrl String?

  width  Int?
  height Int?

  cityImages     CityImage[]
  activityImages ActivityImage[]

  createdAt DateTime @default(now())

  @@index([source, sourceId])
}

model CityImage {
  cityId  Int
  imageId Int

  isCover      Boolean @default(false)
  displayOrder Int     @default(0)

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@id([cityId, imageId])
  @@index([cityId, displayOrder])
}

model ActivityCategory {
  id   Int    @id @default(autoincrement())
  name String @unique

  activities ActivityCategoryOnActivity[]

  createdAt DateTime @default(now())
}

model Activity {
  id     Int @id @default(autoincrement())
  cityId Int

  name        String
  description String?

  durationMinutes Int

  priceMin Decimal? @db.Decimal(10, 2)
  priceMax Decimal? @db.Decimal(10, 2)
  currency String   @default("INR")

  rating          Decimal? @db.Decimal(3, 2)
  reviewCount     Int      @default(0)
  popularityScore Decimal? @db.Decimal(5, 2)

  isActive Boolean @default(true)

  city City @relation(fields: [cityId], references: [id], onDelete: Restrict)

  categories ActivityCategoryOnActivity[]

  images ActivityImage[]

  itineraryItems ItineraryItem[]

  recommendationInteractions RecommendationInteraction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId])
  @@index([popularityScore])
}

model ActivityCategoryOnActivity {
  activityId Int
  categoryId Int

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  category ActivityCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([activityId, categoryId])
  @@index([categoryId])
}

model ActivityImage {
  activityId Int
  imageId    Int

  isCover      Boolean @default(false)
  displayOrder Int     @default(0)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@id([activityId, imageId])
  @@index([activityId, displayOrder])
}

model Trip {
  id     Int @id @default(autoincrement())
  userId Int

  name        String
  description String?

  startDate DateTime
  endDate   DateTime

  budget        Decimal? @db.Decimal(12, 2)
  currency      String   @default("INR")
  travelerCount Int      @default(1)

  coverImageId Int?
  visibility   TripVisibility @default(PRIVATE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  stops TripStop[]

  transports TripTransport[]

  expenses Expense[]

  shares TripShare[]

  recommendationInteractions RecommendationInteraction[]

  generation TripGeneration?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([startDate])
  @@index([visibility])
}

model TripStop {
  id     Int @id @default(autoincrement())
  tripId Int
  cityId Int

  startDate DateTime
  endDate   DateTime

  order Int
  notes String?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  city City @relation(fields: [cityId], references: [id], onDelete: Restrict)

  itineraryItems ItineraryItem[]

  transportsFrom TripTransport[] @relation("TransportFrom")
  transportsTo   TripTransport[] @relation("TransportTo")

  expenses Expense[]

  @@unique([tripId, order])
  @@index([tripId])
  @@index([cityId])
  @@index([startDate, endDate])
}

model TripTransport {
  id Int @id @default(autoincrement())

  tripId Int

  fromStopId Int
  toStopId   Int

  mode TransportMode

  departureTime DateTime?
  arrivalTime   DateTime?

  durationMinutes Int?

  estimatedCost Decimal? @db.Decimal(10, 2)
  currency      String   @default("INR")

  notes String?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  fromStop TripStop @relation("TransportFrom", fields: [fromStopId], references: [id], onDelete: Cascade)

  toStop TripStop @relation("TransportTo", fields: [toStopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tripId])
  @@index([fromStopId])
  @@index([toStopId])
}

model ItineraryItem {
  id         Int @id @default(autoincrement())
  tripStopId Int

  activityId Int?

  date DateTime

  startTime DateTime?
  endTime   DateTime?

  order Int

  customName        String?
  customDescription String?
  customCost        Decimal? @db.Decimal(10, 2)

  notes String?

  tripStop TripStop @relation(fields: [tripStopId], references: [id], onDelete: Cascade)

  activity Activity? @relation(fields: [activityId], references: [id], onDelete: Restrict)

  expenses Expense[]

  @@unique([tripStopId, date, order])
  @@index([tripStopId])
  @@index([activityId])
  @@index([date])
}

model Expense {
  id Int @id @default(autoincrement())

  tripId          Int
  tripStopId      Int?
  itineraryItemId Int?

  category ExpenseCategory

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR")

  description String?
  date        DateTime

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  tripStop TripStop? @relation(fields: [tripStopId], references: [id], onDelete: Cascade)

  itineraryItem ItineraryItem? @relation(fields: [itineraryItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([tripStopId])
  @@index([itineraryItemId])
  @@index([category])
  @@index([date])
}

model SavedDestination {
  userId Int
  cityId Int

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@id([userId, cityId])
  @@index([cityId])
}

model TripShare {
  id Int @id @default(autoincrement())

  tripId Int

  shareToken String @unique

  isActive Boolean @default(true)

  viewCount Int @default(0)

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([isActive])
}

model RecommendationInteraction {
  id Int @id @default(autoincrement())

  userId Int

  activityId Int?
  tripId     Int?

  action RecommendationAction

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  activity Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)

  trip Trip? @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activityId])
  @@index([tripId])
  @@index([userId, action])
  @@index([createdAt])
}

model TripGeneration {
  id Int @id @default(autoincrement())

  userId Int
  tripId Int @unique

  prompt String

  preferencesSnapshot Json

  model String?

  status TripGenerationStatus @default(PENDING)

  generatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([generatedAt])
}

model CommunityPost {
  id            Int               @id @default(autoincrement())
  userId        Int
  title         String
  content       String
  category      CommunityCategory @default(TRAVEL_DISCUSSION)
  coverImageUrl String?
  viewsCount    Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies CommunityReply[]
  likes   CommunityPostLike[]

  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

model CommunityReply {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model CommunityPostLike {
  userId    Int
  postId    Int
  createdAt DateTime @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}
